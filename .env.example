# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres, e.g. Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI assistant (Anthropic API - separate from Claude Code credits)
ANTHROPIC_API_KEY=
# Optional model overrides
# ASSISTANT_MODEL=claude-haiku-5-5
# ADMIN_ASSISTANT_MODEL=claude-sonnet-5-5

# Subscriptions (plan billing) - uses your own Stripe account, separate from each business's deposit keys
# STRIPE_SECRET_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are set above.
# Signing secret of the webhook endpoint https://<your-site>/api/billing/webhook
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# Optional: pre-created recurring Prices ($29.99 and $59.99 monthly). Leave empty to create them automatically.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
